{
  "rewrites": [
    {
      "source": "/api/zhipu/(.*)",
      "destination": "/api/zhipu/[...path]"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/zhipu/[...path].js": {
      "runtime": "edge",
      "minify": false
    }
  }
}